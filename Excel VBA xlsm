    On Error GoTo 0
    
    If chartDate = 0 Then
        MsgBox "Please enter a valid Start Time in C1 first so the audits know which day to plot on.", vbExclamation
        Exit Sub
    End If
    
    lastRow = wsAudit.Cells(wsAudit.Rows.Count, "B").End(xlUp).Row
    eventCount = 0
    
    For i = 2 To lastRow
        objName = UCase(Trim(wsAudit.Cells(i, 3).Value))
        msg = UCase(Trim(wsAudit.Cells(i, 5).Value))
        
        ' Look for "IO.VALUE" instead of "MANSP" for LT108
        If InStr(1, objName, "LT108", vbTextCompare) > 0 And InStr(1, msg, "IO.VALUE", vbTextCompare) > 0 Then
            ReDim Preserve eventTimes(eventCount)
            ReDim Preserve eventLabels(eventCount)
            
            ' Extract ONLY the time from the Audit sheet, then add it to your Dashboard's date
            auditTime = CDbl(CDate(wsAudit.Cells(i, 2).Value)) - Int(CDbl(CDate(wsAudit.Cells(i, 2).Value)))
            eventTimes(eventCount) = chartDate + auditTime
            
            ' Extract the text after "IO.Value"
            valChange = Trim(Split(msg, "IO.VALUE")(1))
            eventLabels(eventCount) = valChange
            
            eventCount = eventCount + 1
        End If
    Next i
    
    If eventCount = 0 Then
        MsgBox "No LT108 manual changes found.", vbInformation
        Exit Sub
    End If
    
    Dim yValues() As Double
    ReDim yValues(eventCount - 1)
    For i = 0 To eventCount - 1
        yValues(i) = 1 ' LT108 sits at the TOP of the axis
    Next i
    
    Application.ScreenUpdating = False
    
    For Each chtObj In wsDash.ChartObjects
        With chtObj.Chart
            
            For i = .SeriesCollection.Count To 1 Step -1
                If .SeriesCollection(i).Name = "LT108 Audit" Then
                    .SeriesCollection(i).Delete
                End If
            Next i
            
            Set srs = .SeriesCollection.NewSeries
            srs.Name = "LT108 Audit"
            srs.XValues = eventTimes
            srs.Values = yValues
            srs.AxisGroup = xlSecondary
            
            srs.Format.Line.Visible = msoFalse
            srs.MarkerStyle = xlMarkerStyleTriangle
            srs.MarkerSize = 8
            srs.MarkerForegroundColor = RGB(0, 112, 192) ' Blue
            srs.MarkerBackgroundColor = RGB(0, 112, 192) ' Blue
            
            srs.HasDataLabels = True
            For i = 1 To eventCount
                srs.Points(i).DataLabel.Text = eventLabels(i - 1)
                ' Placed BELOW the marker so text isn't cut off at the top boundary
                srs.Points(i).DataLabel.Position = xlLabelPositionBelow
                srs.Points(i).DataLabel.Format.TextFrame2.TextRange.Font.Size = 9
                srs.Points(i).DataLabel.Format.TextFrame2.TextRange.Font.Bold = msoTrue
                srs.Points(i).DataLabel.Format.TextFrame2.TextRange.Font.Fill.ForeColor.RGB = RGB(0, 112, 192)
            Next i
            
            .Axes(xlValue, xlSecondary).MinimumScale = 0
            .Axes(xlValue, xlSecondary).MaximumScale = 1
            .Axes(xlValue, xlSecondary).TickLabelPosition = xlTickLabelPositionNone
            
        End With
    Next chtObj
    
    Application.ScreenUpdating = True
    MsgBox eventCount & " LT108 changes successfully mapped to the dashboard!", vbInformation
End Sub
