    Dim eventTimes() As Double, eventLabels() As String
    Dim eventCount As Integer
    Dim chtObj As ChartObject, srs As Series
    Dim objName As String, msg As String
    Dim valChange As String
    Dim chartDate As Double, auditTime As Double
    
    Set wsAudit = ThisWorkbook.Sheets("ManualAudit")
    Set wsDash = ThisWorkbook.Sheets("Dashboard")
    
    ' Grab the base date from your Time Filter (Cell C1) so they match
    On Error Resume Next
